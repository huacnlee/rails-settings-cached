source "https://rubygems.org"

gem "railties", "~> 6.1.4"
gem "activerecord", "~> 6.1.4"
gem "sqlite3", "~> 1.4"
# Rails < 8.1 is incompatible with minitest 6 and json 3
gem "minitest", "< 6"
gem "json", "< 3"
# concurrent-ruby 1.3.5 stopped requiring "logger", which Rails < 7.1 relies on
gem "concurrent-ruby", "< 1.3.5"

gemspec path: ".."
