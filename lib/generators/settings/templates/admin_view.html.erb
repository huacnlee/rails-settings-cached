<div class="settings-form">
  <h2>Application Settings</h2>

  <%%= form_with(model: Setting.new, url: admin_settings_path) do |f| %>
    <%% if @errors&.any? %>
      <div class="alert alert-danger">
        <ul>
          <%% @errors.full_messages.each do |msg| %>
            <li><%%= msg %></li>
          <%% end %>
        </ul>
      </div>
    <%% end %>

    <%% Setting.defined_fields.group_by { |f| f[:scope] }.each do |scope, fields| %>
      <div class="settings-section">
        <h3><%%= scope.to_s.titleize %></h3>
        
        <%% fields.each do |field| %>
          <div class="form-group">
            <%% field_name = field[:key] %>
            <%% field_type = field[:type] %>
            <%% readonly = field[:readonly] %>
            
            <label><%%= field_name.humanize %></label>
            
            <%% case field_type %>
            <%% when :boolean %>
              <div class="form-check">
                <%%= f.check_box field_name, 
                              checked: Setting.send(field_name), 
                              class: "form-check-input",
                              disabled: readonly %>
              </div>
            <%% when :array %>
              <%%= f.text_area field_name,
                            value: Setting.send(field_name)&.join("\n"),
                            class: "form-control",
                            rows: 3,
                            disabled: readonly %>
            <%% when :hash %>
              <%%= f.text_area field_name,
                            value: YAML.dump(Setting.send(field_name)),
                            class: "form-control",
                            rows: 5,
                            disabled: readonly %>
              <small class="form-text text-muted">Use YAML format</small>
            <%% else %>
              <%%= f.text_field field_name,
                             value: Setting.send(field_name),
                             class: "form-control",
                             disabled: readonly %>
            <%% end %>

            <%% if field[:options]&.dig(:help_text).present? %>
              <small class="form-text text-muted">
                <%%= field[:options][:help_text] %>
              </small>
            <%% end %>
            
            <%% if readonly %>
              <small class="form-text text-muted">
                <em>This setting is readonly</em>
              </small>
            <%% end %>
          </div>
        <%% end %>
      </div>
    <%% end %>

    <div class="form-actions">
      <%%= f.submit 'Save Settings', class: 'btn btn-primary' %>
    </div>
  <%% end %>
</div>

<%% content_for :styles do %>
<style>
  .settings-form {
    max-width: 800px;
    margin: 20px auto;
    padding: 20px;
  }
  
  .settings-section {
    margin-bottom: 30px;
    padding: 20px;
    background: #f8f9fa;
    border-radius: 5px;
  }
  
  .form-group {
    margin-bottom: 1rem;
  }
  
  .form-actions {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid #dee2e6;
  }
</style>
<%% end %> 